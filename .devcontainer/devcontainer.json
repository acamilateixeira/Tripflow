{
  "name": "TripFlow",
  "dockerComposeFile": "docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/tripflow",
  "forwardPorts": [8000, 15672],
  "portsAttributes": {
    "8000": { "label": "API TripFlow", "onAutoForward": "notify" },
    "15672": { "label": "RabbitMQ (guest/guest)" }
  },
  "postCreateCommand": "bash scripts/dev-setup.sh",
  "postStartCommand": "bash scripts/dev-start.sh",
  "customizations": {
    "vscode": {
      "extensions": ["bmewburn.vscode-intelephense-client", "humao.rest-client"]
    }
  }
}
